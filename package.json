{
  "name": "emulator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "docs:dev": "vitepress dev website",
    "docs:build": "npm run report:check && vitepress build website",
    "docs:preview": "vitepress preview website",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.app.json",
    "test": "node scripts/test/run.mjs",
    "core:demo": "npm run build && node examples/machine/add.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run site:build",
    "assembler:demo": "npm run build && node examples/assembly/run.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "app:build": "tsc -p tsconfig.app.json && vite build",
    "site:build": "npm run docs:build && npm run app:build && node scripts/site/prepare.mjs",
    "test:browser": "playwright test",
    "programs:prepare": "node scripts/programs/prepare.mjs",
    "arrays:demo": "npm run build && node examples/assembly/arrays.mjs",
    "report:check": "node scripts/report/check.mjs",
    "report:pdf": "npm run docs:build && node scripts/report/pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
